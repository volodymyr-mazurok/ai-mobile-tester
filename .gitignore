node_modules/

# Secrets. LOCAL ONLY - in CI these come from a secret variable group instead.
# `.env.example` documents the NAMES and is committed.
# ⚠️ A secret that reaches a commit is in history forever. See config/env/requireEnv.ts.
.env
.env.*
!.env.example

# App binaries are large, build-specific, and change every release - fetch or
# build them locally instead (`npm run setup`). Never commit these.
apps/*
!apps/.gitkeep

# WDIO/Appium run output
allure-results/
allure-report/
test-results/
errorShots/
# Generated by `npm run report` - rebuilt from test-results/ on demand.
reports/
logs/
*.log

.DS_Store

# Live-capture scratch output (inspect-live-screen skill)
.inspect/

# Shared seeded-client fixture for a run (see test/support/sharedClient.ts)

# Exploratory session evidence (explore-app skill) and diagnostic scratch output
.explore/
.diag/

# The device lock (scripts/device-lock.mjs) - one Appium session per device
.device-lock.json

# Local evidence kept aside by hand for run-to-run comparison - never committed.
archive/

# The Ukrainian guide - 2.6MB of html+pdf that describes a `demo` branch run, so
# it goes stale against `main` by construction, and a regenerated pdf re-diffs
# wholesale every time. Deliberately untracked IN FULL, sources included.
#
# ⚠️ NOT RECOVERABLE FROM THIS REPO. guide.src.html and build-guide.mjs - the
# only way to rebuild it - are neither tracked nor in history; they are kept
# outside the repo. Ask the maintainer if the guide needs updating.
# If it is ever worth maintaining again, track those two sources and ignore
# only guide.html / guide.pdf / assets.
docs/uk/
